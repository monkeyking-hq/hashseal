{
  "name": "hashseal",
  "displayName": "HashSeal",
  "description": "Seal and verify AI instruction files with inline diagnostics and status bar indicator.",
  "version": "0.6.1",
  "publisher": "hashseal",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hashseal.checkWorkspace",
        "title": "HashSeal: Check Workspace"
      },
      {
        "command": "hashseal.checkActiveFile",
        "title": "HashSeal: Check Active File"
      },
      {
        "command": "hashseal.sealInstructWorkspace",
        "title": "HashSeal: Seal Instruct (Workspace)"
      }
    ],
    "configuration": {
      "title": "HashSeal",
      "properties": {
        "hashseal.bin": {
          "type": "string",
          "default": "",
          "description": "Absolute path to hashseal CLI. Empty = HASHSEAL_BIN env, else hashseal on PATH."
        },
        "hashseal.checkBin": {
          "type": "string",
          "default": "",
          "description": "Absolute path to hashseal-check. Empty = HASHSEAL_CHECK_BIN env, else hashseal-check on PATH."
        },
        "hashseal.preferCheckBinary": {
          "type": "boolean",
          "default": false,
          "description": "Prefer tiny hashseal-check (plain text) over JSON diagnostics."
        },
        "hashseal.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check instruction files on save."
        },
        "hashseal.requireSignature": {
          "type": "boolean",
          "default": false,
          "description": "Require cryptographic signatures when checking."
        }
      }
    }
  },
  "scripts": {
    "lint": "node -c extension.js"
  }
}
