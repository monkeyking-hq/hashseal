{
  "manifest_version": 3,
  "name": "HashSeal Check",
  "version": "0.1.0",
  "description": "Check pasted HashSeal-sealed Markdown: valid, MISMATCH, or missing seal (pure JS blake3).",
  "action": {
    "default_title": "HashSeal Check",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
