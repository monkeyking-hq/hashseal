{
  "version": 1,
  "document": {
    "enable": true,
    "include": [
      "**/AGENTS.md",
      "**/AGENTS.local.md",
      "**/AGENT.md",
      "**/CLAUDE.md",
      "**/GEMINI.md",
      "**/QWEN.md",
      "**/CODEX.md",
      "**/GROK.md",
      "**/CONVENTIONS.md",
      "**/.cursorrules",
      "**/.windsurfrules",
      "**/.clinerules",
      "**/.github/copilot-instructions.md",
      "**/copilot-instructions.md",
      "**/SKILL.md",
      "**/.cursor/rules/**/*.md",
      "**/.cursor/rules/**/*.mdc",
      "**/.cursor/skills/**/*.md",
      "**/.cursor/commands/**/*.md",
      "**/.windsurf/**/*.md",
      "**/.continue/rules/**/*.md",
      "**/.clinerules/**/*.md",
      "**/.agents/**/*.md",
      "**/.claude/**/*.md",
      "**/.github/agents/**/*.md",
      "**/.github/prompts/**/*.md",
      "**/.github/skills/**/*.md",
      "**/.github/instructions/**/*.md",
      "**/.gemini/**/*.md",
      "**/.grok/**/*.md",
      "**/.augment/**/*.md",
      "**/.alquimia/**/*.md",
      "**/.codebuddy/**/*.md",
      "**/.factory/**/*.md",
      "**/.firebender/**/*.md",
      "**/.devin/**/*.md",
      "**/.junie/**/*.md",
      "**/.kilo/**/*.md",
      "**/.kilocode/**/*.md",
      "**/.kiro/**/*.md",
      "**/.lingma/**/*.md",
      "**/.omp/**/*.md",
      "**/.pi/**/*.md",
      "**/.qoder/**/*.md",
      "**/.qwen/**/*.md",
      "**/.shai/**/*.md",
      "**/.tabnine/**/*.md",
      "**/.trae/**/*.md",
      "**/.zcode/**/*.md",
      "**/.bob/**/*.md",
      "**/.kimi/**/*.md",
      "**/.kimi-code/**/*.md",
      "**/.rovodev/**/*.md"
    ],
    "exclude": [
      "**/.git/**",
      "**/target/**",
      "**/node_modules/**",
      "**/build/**",
      "**/dist/**",
      "**/vendor/**",
      "**/.hashseal/**",
      "**/hashseal-bundle/**"
    ],
    "canonical": "full",
    "field": "hashseal",
    "auto_frontmatter": true,
    "algorithm": "blake3"
  },
  "tree": {
    "include": ["**/*"],
    "exclude": [
      "**/.git/**",
      "**/target/**",
      "**/node_modules/**",
      "**/hashseal-bundle/**",
      "**/.hashseal/**"
    ],
    "line_endings": "lf-text",
    "algorithm": "blake3"
  },
  "signing": {
    "enable": false,
    "require": false
  },
  "report": {
    "write": true,
    "pretty": true
  },
  "enforce": {
    "on_tree_mismatch": "fail",
    "on_doc_mismatch": "fail",
    "on_missing_ledger": "fail"
  }
}
