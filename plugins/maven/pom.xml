<?xml version="1.0" encoding="UTF-8"?>
<!--
  HashSeal Maven plugin — thin Mojo(s) that shell to the hashseal CLI.
  PATH / hashseal.bin required.

  Publish (with verify SDK + parent): from monorepo root
    mvn -f java/pom.xml release:prepare release:perform

  settings.xml server id: hashseal-central

  Copyright (c) 2026 MonkeyKing.dev
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.hashseal</groupId>
    <artifactId>hashseal-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../java/pom.xml</relativePath>
  </parent>

  <artifactId>hashseal-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>HashSeal Maven Plugin</name>
  <description>Thin HashSeal Mojo(s) that invoke the hashseal CLI (PATH / hashseal.bin)</description>
  <url>https://hashseal.ai</url>

  <!-- Explicit Central metadata (self-contained if parent resolution is delayed) -->
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>MonkeyKing.dev</name>
      <email>info@hashseal.ai</email>
      <organization>MonkeyKing.dev</organization>
      <organizationUrl>https://monkeyking.dev</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/monkeyking-hq/hashseal.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/monkeyking-hq/hashseal.git</developerConnection>
    <url>https://github.com/monkeyking-hq/hashseal</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/monkeyking-hq/hashseal/issues</url>
  </issueManagement>

  <properties>
    <maven.version>3.9.6</maven.version>
    <maven-plugin-plugin.version>3.13.1</maven-plugin-plugin.version>
    <maven-plugin-annotations.version>3.13.1</maven-plugin-annotations.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven-plugin-annotations.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${maven-plugin-plugin.version}</version>
        <configuration>
          <goalPrefix>hashseal</goalPrefix>
          <skipErrorNoDescriptorsFound>true</skipErrorNoDescriptorsFound>
        </configuration>
        <executions>
          <execution>
            <id>default-descriptor</id>
            <phase>process-classes</phase>
            <goals>
              <goal>descriptor</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
