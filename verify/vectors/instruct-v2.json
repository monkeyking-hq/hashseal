{
  "version": 2,
  "spec": "instruct-v2",
  "algorithm": "blake3",
  "canonical": "full",
  "field": "hashseal",
  "description": "Frozen HashSeal instruct seal/check vectors for FULL canonical mode (instruct-v2 lossless raw-FM framing). Digests generated by hashseal-core; all multi-language verifiers must match.",
  "notes": [
    "Reserved top-level FM keys excluded from hash: hashseal (or configured field), hashseal_sig, hashseal_sig_format, hashseal_signer, hashseal_scope, hashseal_key_id.",
    "FULL mode with non-empty kept FM: HASHSEAL-INSTRUCT-V2\\nFM\\n<kept_fm_lf>\\nBODY\\n<body_lf>.",
    "FULL mode with no non-empty kept FM: HASHSEAL-INSTRUCT-V2\\nBODY\\n<body_lf>.",
    "Line endings are normalized to LF before hashing; leading UTF-8 BOM is stripped.",
    "Signature verification is out of scope for these vectors; suspicious Unicode checks run before digest check."
  ],
  "cases": [
    {
      "id": "body_only_simple",
      "description": "Seal body-only markdown (no prior front matter); check must pass",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:08a635fc990e9aedb6b0690a5feb7147a8b2673027e5635e1849fbe581d271f6\"\n---\n# Hello\n\nAgent rules.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:08a635fc990e9aedb6b0690a5feb7147a8b2673027e5635e1849fbe581d271f6"
      }
    },
    {
      "id": "body_empty",
      "description": "Empty body sealed document",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:9fdcc176bb7a72f91ee8d3b08f5bcc928eb46afc9ddb49a222654e998f8e69ad\"\n---\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:9fdcc176bb7a72f91ee8d3b08f5bcc928eb46afc9ddb49a222654e998f8e69ad"
      }
    },
    {
      "id": "fm_and_body",
      "description": "Front matter keys + body included in FULL hash",
      "kind": "check",
      "text": "---\ntitle: agents\npolicy: strict\nhashseal: \"blake3:fddb666d90a2785d8ede61c43462b6f4788ccc2cf2f24e0f0949d8676a9c7988\"\n---\n# Hi\n\nDo good.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:fddb666d90a2785d8ede61c43462b6f4788ccc2cf2f24e0f0949d8676a9c7988"
      }
    },
    {
      "id": "fm_key_order_preserved",
      "description": "Raw FM preserves key order (different order produces different digest than fm_and_body)",
      "kind": "check",
      "text": "---\npolicy: strict\ntitle: agents\nhashseal: \"blake3:20c0d80383d60536bc8bfd577b6dc08510dbd64060f0a500eb82fa35f523f066\"\n---\n# Hi\n\nDo good.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:20c0d80383d60536bc8bfd577b6dc08510dbd64060f0a500eb82fa35f523f066"
      }
    },
    {
      "id": "fm_yaml_list_protected",
      "description": "YAML list items in front matter are included verbatim in the hash",
      "kind": "check",
      "text": "---\nglobs:\n  - \"*.ts\"\n  - \"*.tsx\"\nhashseal: \"blake3:967d0fd7f09ebfd66b578bd8d6327caff8c0805ce7a6466c6ddc3740c341dc8c\"\n---\n# Rule\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:967d0fd7f09ebfd66b578bd8d6327caff8c0805ce7a6466c6ddc3740c341dc8c"
      }
    },
    {
      "id": "fm_yaml_list_tampered",
      "description": "Tampering a YAML list item in front matter fails with mismatch",
      "kind": "check",
      "text": "---\nglobs:\n  - \"*.js\"\n  - \"*.tsx\"\nhashseal: \"blake3:967d0fd7f09ebfd66b578bd8d6327caff8c0805ce7a6466c6ddc3740c341dc8c\"\n---\n# Rule\n",
      "expect": {
        "ok": false,
        "status": "mismatch",
        "expected": "blake3:967d0fd7f09ebfd66b578bd8d6327caff8c0805ce7a6466c6ddc3740c341dc8c",
        "actual": "blake3:5dde0de35773d1f8614ab3b32922d66b6cfe230d815e98a95f78b9c2492adce2"
      }
    },
    {
      "id": "fm_nested_map_protected",
      "description": "Nested YAML maps in front matter are included verbatim in the hash",
      "kind": "check",
      "text": "---\ntools:\n  bash: false\n  read: true\nhashseal: \"blake3:a5cae04ed4fa194c42f462fea7ae5aef59181a4ee6ff63f7b78193b82927bbe0\"\n---\n# Skill\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:a5cae04ed4fa194c42f462fea7ae5aef59181a4ee6ff63f7b78193b82927bbe0"
      }
    },
    {
      "id": "fm_quoted_value",
      "description": "Quoted front-matter values are preserved verbatim",
      "kind": "check",
      "text": "---\ntitle: \"hello world\"\nhashseal: \"blake3:3b49248dd7d60a01551f9b3c9c230f40e8071a4c4b23f5b1406f9a86faf15a55\"\n---\n# T\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:3b49248dd7d60a01551f9b3c9c230f40e8071a4c4b23f5b1406f9a86faf15a55"
      }
    },
    {
      "id": "no_fm_multiline",
      "description": "Multiline body without prior FM",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:c7596dc9aa6e97c74a3d3f7ec5d156702a4197bfdeafd0263a7e4d2afc4fb47b\"\n---\nLine one\n\nLine two\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:c7596dc9aa6e97c74a3d3f7ec5d156702a4197bfdeafd0263a7e4d2afc4fb47b"
      }
    },
    {
      "id": "sealed_tampered_body",
      "description": "Body tamper after seal -> mismatch with both digests",
      "kind": "check",
      "text": "---\ntitle: demo\nhashseal: \"blake3:0277d36f9a1a7245392b6b55b0e6db15c8e7ee528fa551f68543132b327758d0\"\n---\n# Demo\n\nEvil.\n",
      "expect": {
        "ok": false,
        "status": "mismatch",
        "expected": "blake3:0277d36f9a1a7245392b6b55b0e6db15c8e7ee528fa551f68543132b327758d0",
        "actual": "blake3:7f551081fbc4a5af89acff172f2035fe09519e65dd6fa76c4452d4d01b729aea"
      }
    },
    {
      "id": "missing_seal",
      "description": "Front matter present but no hashseal field",
      "kind": "check",
      "text": "---\ntitle: bare\n---\n# No seal\n",
      "expect": {
        "ok": false,
        "status": "missing_seal",
        "actual": "blake3:4983016f633d3381555f226510ebabe2e00fc96eae98f6507849783f1f0791ad"
      }
    },
    {
      "id": "crlf_normalized",
      "description": "CRLF body lines normalize to same digest as LF",
      "kind": "check",
      "text": "---\r\nhashseal: \"blake3:d7eab46c0160058abbe34a5da2fef9dcb2611345ff01e5158a65865e1c4c57b9\"\r\n---\r\n# T\r\n\r\nline\r\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:d7eab46c0160058abbe34a5da2fef9dcb2611345ff01e5158a65865e1c4c57b9"
      }
    },
    {
      "id": "blake3_hello_bytes",
      "description": "Raw blake3 of ASCII hello (algorithm smoke test)",
      "kind": "raw_digest",
      "bytes_utf8": "hello",
      "expect": {
        "digest": "blake3:ea8f163db38682925e4491c5e58d4bb3506ef8c14eb78a86e908c5624a67200f"
      }
    },
    {
      "id": "reserved_sig_excluded",
      "description": "hashseal_sig block (including -----BEGIN PGP SIGNATURE-----) is reserved and excluded",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:08a635fc990e9aedb6b0690a5feb7147a8b2673027e5635e1849fbe581d271f6\"\nhashseal_sig: |\n  -----BEGIN PGP SIGNATURE-----\n  fake\n  -----END PGP SIGNATURE-----\n---\n# Hello\n\nAgent rules.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:08a635fc990e9aedb6b0690a5feb7147a8b2673027e5635e1849fbe581d271f6"
      }
    },
    {
      "id": "reserved_v2_metadata_excluded",
      "description": "All instruct-v2 signature metadata fields are reserved and excluded",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:08a635fc990e9aedb6b0690a5feb7147a8b2673027e5635e1849fbe581d271f6\"\nhashseal_sig_format: ssh\nhashseal_signer: nate@monkeyking.dev\nhashseal_scope: AGENTS.md\nhashseal_key_id: deadbeef\n---\n# Hello\n\nAgent rules.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:08a635fc990e9aedb6b0690a5feb7147a8b2673027e5635e1849fbe581d271f6"
      }
    },
    {
      "id": "bom_prefix",
      "description": "UTF-8 BOM before front matter is stripped before parse/hash",
      "kind": "check",
      "text": "﻿---\nhashseal: \"blake3:08a635fc990e9aedb6b0690a5feb7147a8b2673027e5635e1849fbe581d271f6\"\n---\n# Hello\n\nAgent rules.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:08a635fc990e9aedb6b0690a5feb7147a8b2673027e5635e1849fbe581d271f6"
      }
    },
    {
      "id": "invalid_digest_format",
      "description": "hashseal present but not alg:hex -> invalid_format",
      "kind": "check",
      "text": "---\nhashseal: \"not-a-digest\"\n---\n# x\n",
      "expect": {
        "ok": false,
        "status": "invalid_format"
      }
    },
    {
      "id": "suspicious_unicode_bidi",
      "description": "BiDi override control U+202E triggers suspicious_unicode",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:0000\"\n---\n# Hi ‮evil\n",
      "expect": {
        "ok": false,
        "status": "suspicious_unicode"
      }
    },
    {
      "id": "suspicious_unicode_tag",
      "description": "Unicode tag character U+E0041 triggers suspicious_unicode",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:0000\"\n---\n# Hi 󠁁\n",
      "expect": {
        "ok": false,
        "status": "suspicious_unicode"
      }
    }
  ]
}
