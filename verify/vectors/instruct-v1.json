{
  "version": 1,
  "spec": "instruct-v1",
  "algorithm": "blake3",
  "canonical": "full",
  "field": "hashseal",
  "description": "Frozen HashSeal instruct seal/check vectors for FULL canonical mode. Digests generated by hashseal-core; all multi-language verifiers must match.",
  "notes": [
    "Chicken-and-egg: hashseal / hashseal_sig / hashseal_key_id are excluded from the hashed payload.",
    "FULL mode: sorted non-reserved front-matter keys as key: value\\n lines, then a blank line (extra \\n), then LF-normalized body. If no non-reserved FM keys, body only.",
    "Line endings in the body are normalized to LF before hashing.",
    "Signature verification is out of scope for these vectors (digest check only)."
  ],
  "cases": [
    {
      "id": "body_only_simple",
      "description": "Seal body-only markdown (no prior front matter); check must pass",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:25280e93176b8b5ae3f4c2dd4b8fef7a20c4a626ea8dfd933b0e77b3a240dccb\"\n---\n# Hello\n\nAgent rules.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:25280e93176b8b5ae3f4c2dd4b8fef7a20c4a626ea8dfd933b0e77b3a240dccb"
      }
    },
    {
      "id": "body_empty",
      "description": "Empty body sealed document",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262\"\n---\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"
      }
    },
    {
      "id": "fm_and_body",
      "description": "Front matter keys + body included in FULL hash",
      "kind": "check",
      "text": "---\ntitle: agents\npolicy: strict\nhashseal: \"blake3:aea5dc3b0968d97bda7c7d0e9c8cc88d88eee634097892e6726cc3934ba47955\"\n---\n# Hi\n\nDo good.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:aea5dc3b0968d97bda7c7d0e9c8cc88d88eee634097892e6726cc3934ba47955"
      }
    },
    {
      "id": "fm_sorted_order",
      "description": "FM keys are sorted alphabetically in the hash payload (alpha before zed)",
      "kind": "check",
      "text": "---\nzed: last\nalpha: first\nhashseal: \"blake3:dbd39302d4856c419828ffa34544c70fe0d535ff63435d2cdafad26be491e49b\"\n---\nbody\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:dbd39302d4856c419828ffa34544c70fe0d535ff63435d2cdafad26be491e49b"
      }
    },
    {
      "id": "fm_quoted_value",
      "description": "Values with spaces are quoted in the canonical FM string",
      "kind": "check",
      "text": "---\ntitle: hello world\nhashseal: \"blake3:22b858d34118cb1256b7150bb908fe8f7859788679dc09eaf98dbe911ac96287\"\n---\n# T\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:22b858d34118cb1256b7150bb908fe8f7859788679dc09eaf98dbe911ac96287"
      }
    },
    {
      "id": "no_fm_multiline",
      "description": "Multiline body without prior FM",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:8c3ff14d03f1b798e781585e547c4f8270936dad3337cd31f8079df1d6a010b2\"\n---\nLine one\n\nLine two\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:8c3ff14d03f1b798e781585e547c4f8270936dad3337cd31f8079df1d6a010b2"
      }
    },
    {
      "id": "sealed_valid",
      "description": "Demo document with title FM + body",
      "kind": "check",
      "text": "---\ntitle: demo\nhashseal: \"blake3:97bc50a158eeb098cd9ef101a8106b4dd3ae1585e16486d3e8761a54421e5fda\"\n---\n# Demo\n\nContent.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:97bc50a158eeb098cd9ef101a8106b4dd3ae1585e16486d3e8761a54421e5fda"
      }
    },
    {
      "id": "sealed_tampered_body",
      "description": "Body tamper after seal → MISMATCH with both digests",
      "kind": "check",
      "text": "---\ntitle: demo\nhashseal: \"blake3:97bc50a158eeb098cd9ef101a8106b4dd3ae1585e16486d3e8761a54421e5fda\"\n---\n# Demo\n\nEvil.\n",
      "expect": {
        "ok": false,
        "status": "mismatch",
        "expected": "blake3:97bc50a158eeb098cd9ef101a8106b4dd3ae1585e16486d3e8761a54421e5fda",
        "actual": "blake3:aaa67bba6f1ab0fd3283fe9c2ece177f5ccd7df7af7d656e81a176274cfeb8b0"
      }
    },
    {
      "id": "missing_seal",
      "description": "Front matter present but no hashseal field",
      "kind": "check",
      "text": "---\ntitle: bare\n---\n# No seal\n",
      "expect": {
        "ok": false,
        "status": "missing_seal",
        "actual": "blake3:6ccf392c90b5a8544e441d7af2b690416e412f4c3df13f4376157be709c999fa"
      }
    },
    {
      "id": "crlf_normalized",
      "description": "CRLF body lines normalize to same digest as LF",
      "kind": "check",
      "text": "---\r\nhashseal: \"blake3:983ec02dd17ae90b7653a62f750f83c2f0e2dbe41e8c5380a454847685dfdd63\"\r\n---\r\n# T\r\n\r\nline\r\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:983ec02dd17ae90b7653a62f750f83c2f0e2dbe41e8c5380a454847685dfdd63"
      }
    },
    {
      "id": "blake3_hello_bytes",
      "description": "Raw blake3 of ASCII 'hello' (algorithm smoke test, not instruct)",
      "kind": "raw_digest",
      "bytes_utf8": "hello",
      "expect": {
        "digest": "blake3:ea8f163db38682925e4491c5e58d4bb3506ef8c14eb78a86e908c5624a67200f"
      }
    },
    {
      "id": "reserved_sig_excluded",
      "description": "hashseal_sig block is reserved and excluded from FULL hash (digest still valid)",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:25280e93176b8b5ae3f4c2dd4b8fef7a20c4a626ea8dfd933b0e77b3a240dccb\"\nhashseal_sig: |\n  -----BEGIN PGP SIGNATURE-----\n  fake\n  -----END PGP SIGNATURE-----\n---\n# Hello\n\nAgent rules.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:25280e93176b8b5ae3f4c2dd4b8fef7a20c4a626ea8dfd933b0e77b3a240dccb"
      }
    },
    {
      "id": "reserved_key_id_excluded",
      "description": "hashseal_key_id is reserved and excluded from FULL hash",
      "kind": "check",
      "text": "---\nhashseal: \"blake3:25280e93176b8b5ae3f4c2dd4b8fef7a20c4a626ea8dfd933b0e77b3a240dccb\"\nhashseal_key_id: deadbeef\n---\n# Hello\n\nAgent rules.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:25280e93176b8b5ae3f4c2dd4b8fef7a20c4a626ea8dfd933b0e77b3a240dccb"
      }
    },
    {
      "id": "bom_prefix",
      "description": "UTF-8 BOM before front matter is stripped before parse/hash",
      "kind": "check",
      "text": "\uFEFF---\nhashseal: \"blake3:25280e93176b8b5ae3f4c2dd4b8fef7a20c4a626ea8dfd933b0e77b3a240dccb\"\n---\n# Hello\n\nAgent rules.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:25280e93176b8b5ae3f4c2dd4b8fef7a20c4a626ea8dfd933b0e77b3a240dccb"
      }
    },
    {
      "id": "fm_comment_ignored",
      "description": "YAML # comment lines in front matter are ignored (same digest as sealed_valid)",
      "kind": "check",
      "text": "---\n# comment line\ntitle: demo\nhashseal: \"blake3:97bc50a158eeb098cd9ef101a8106b4dd3ae1585e16486d3e8761a54421e5fda\"\n---\n# Demo\n\nContent.\n",
      "expect": {
        "ok": true,
        "status": "valid",
        "digest": "blake3:97bc50a158eeb098cd9ef101a8106b4dd3ae1585e16486d3e8761a54421e5fda"
      }
    },
    {
      "id": "invalid_digest_format",
      "description": "hashseal present but not alg:hex → invalid_format",
      "kind": "check",
      "text": "---\nhashseal: \"not-a-digest\"\n---\n# x\n",
      "expect": {
        "ok": false,
        "status": "invalid_format"
      }
    }
  ]
}
