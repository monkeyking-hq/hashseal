{
  "version": 1,
  "spec": "tree-v1",
  "algorithm": "blake3",
  "line_endings_lf_text": true,
  "description": "Frozen HashSeal tree seal/verify vectors. Digests generated by hashseal-core seal_tree / file hash policy; multi-language tree verifiers must match.",
  "notes": [
    "Text extensions (md, txt, rs, …) are LF-normalized and BOM-stripped before blake3; size is on-disk byte length before normalize.",
    "Non-text paths (e.g. .dat) are hashed raw (no CRLF→LF).",
    "Paths are forward-slash relative, sorted lexicographically in the ledger.",
    "verify_tree cases: materialize `files`, compare against frozen `ledger_entries` with the same include/exclude as seal (vectors use include **/* and empty exclude unless noted).",
    "Findings name every non-OK path with status + digests (never silent exit-only)."
  ],
  "text_extensions": [
    "md", "txt", "toml", "yml", "yaml", "json", "rs", "java", "go", "py", "js",
    "ts", "tsx", "jsx", "css", "html", "xml", "sh", "ps1", "c", "h", "cpp", "cs", "rb", "svg"
  ],
  "cases": [
    {
      "id": "raw_text_lf",
      "description": "Blake3 of LF text file after text policy",
      "kind": "raw_file_digest",
      "path": "src/a.txt",
      "content": "hello\n",
      "expect": {
        "digest": "blake3:8e4c7c1b99dbfd50e7a95185fead5ee1448fa904a2fdd778eaf5f2dbfd629a99",
        "size": 6
      }
    },
    {
      "id": "raw_text_crlf_same_as_lf",
      "description": "CRLF text normalizes to same digest as LF body",
      "kind": "raw_file_digest",
      "path": "a.txt",
      "content": "hello\r\nworld\r\n",
      "expect": {
        "digest": "blake3:e55980c788fb1801601cc1aca0af926bf091d52cf906c60ef5b341d108e881a9",
        "size": 14
      }
    },
    {
      "id": "raw_text_lf_pair",
      "description": "LF pair of previous case — same digest, smaller size",
      "kind": "raw_file_digest",
      "path": "a.txt",
      "content": "hello\nworld\n",
      "expect": {
        "digest": "blake3:e55980c788fb1801601cc1aca0af926bf091d52cf906c60ef5b341d108e881a9",
        "size": 12
      }
    },
    {
      "id": "raw_binary_crlf_no_norm",
      "description": "Non-text extension: raw bytes, CRLF not normalized",
      "kind": "raw_file_digest",
      "path": "bin.dat",
      "content": "hello\r\n",
      "expect": {
        "digest": "blake3:2b5974a9767a33204c2d1583bb4b1ba70f24e2970cbc522073df001272525954",
        "size": 7
      }
    },
    {
      "id": "raw_empty_text",
      "description": "Empty text file digest",
      "kind": "raw_file_digest",
      "path": "empty.txt",
      "content": "",
      "expect": {
        "digest": "blake3:af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262",
        "size": 0
      }
    },
    {
      "id": "roundtrip_two_files",
      "description": "Seal two files; verify ok",
      "kind": "verify_tree",
      "files": {
        "src/a.txt": "hello\n",
        "src/b.txt": "world\n"
      },
      "include": ["**/*"],
      "exclude": [],
      "ledger_entries": [
        {
          "path": "src/a.txt",
          "digest": "blake3:8e4c7c1b99dbfd50e7a95185fead5ee1448fa904a2fdd778eaf5f2dbfd629a99",
          "size": 6
        },
        {
          "path": "src/b.txt",
          "digest": "blake3:26e70f0a438787ee143979a9b519a4a330ea21e0a23d31fcb47051e70b8fe5ad",
          "size": 6
        }
      ],
      "expect": {
        "ok": true,
        "checked": 2,
        "findings": []
      }
    },
    {
      "id": "crlf_sealed_lf_on_disk_ok",
      "description": "Ledger sealed from CRLF; disk LF still matches (text policy)",
      "kind": "verify_tree",
      "files": {
        "a.txt": "hello\nworld\n"
      },
      "include": ["**/*"],
      "exclude": [],
      "ledger_entries": [
        {
          "path": "a.txt",
          "digest": "blake3:e55980c788fb1801601cc1aca0af926bf091d52cf906c60ef5b341d108e881a9",
          "size": 14
        }
      ],
      "expect": {
        "ok": true,
        "checked": 1,
        "findings": []
      }
    },
    {
      "id": "detect_mismatch",
      "description": "Body changed → mismatch with both digests named",
      "kind": "verify_tree",
      "files": {
        "src/a.txt": "evil\n"
      },
      "include": ["**/*"],
      "exclude": [],
      "ledger_entries": [
        {
          "path": "src/a.txt",
          "digest": "blake3:8e4c7c1b99dbfd50e7a95185fead5ee1448fa904a2fdd778eaf5f2dbfd629a99",
          "size": 6
        }
      ],
      "expect": {
        "ok": false,
        "checked": 1,
        "findings": [
          {
            "path": "src/a.txt",
            "status": "mismatch",
            "expected": "blake3:8e4c7c1b99dbfd50e7a95185fead5ee1448fa904a2fdd778eaf5f2dbfd629a99",
            "actual": "blake3:2a17c23ddf66f8b2f5c3e7a375bc7c67acab54c85de0c8fbb91d1e4b62aa87b5"
          }
        ]
      }
    },
    {
      "id": "detect_removed",
      "description": "Ledger path missing on disk → removed",
      "kind": "verify_tree",
      "files": {},
      "include": ["**/*"],
      "exclude": [],
      "ledger_entries": [
        {
          "path": "src/b.txt",
          "digest": "blake3:26e70f0a438787ee143979a9b519a4a330ea21e0a23d31fcb47051e70b8fe5ad",
          "size": 6
        }
      ],
      "expect": {
        "ok": false,
        "checked": 1,
        "findings": [
          {
            "path": "src/b.txt",
            "status": "removed",
            "expected": "blake3:26e70f0a438787ee143979a9b519a4a330ea21e0a23d31fcb47051e70b8fe5ad",
            "actual": null
          }
        ]
      }
    },
    {
      "id": "detect_added",
      "description": "Extra file on disk not in ledger → added",
      "kind": "verify_tree",
      "files": {
        "src/c.txt": "new\n"
      },
      "include": ["**/*"],
      "exclude": [],
      "ledger_entries": [],
      "expect": {
        "ok": false,
        "checked": 0,
        "findings": [
          {
            "path": "src/c.txt",
            "status": "added",
            "expected": null,
            "actual": "blake3:79d1d8da0b625035cdbfc9d51841030861b9f4cf7c5abbe442a8d13efc352170"
          }
        ]
      }
    },
    {
      "id": "detect_modify_add_remove",
      "description": "Combined mismatch + removed + added (every path listed)",
      "kind": "verify_tree",
      "files": {
        "a.txt": "changed\n",
        "c.txt": "new\n"
      },
      "include": ["**/*"],
      "exclude": [],
      "ledger_entries": [
        {
          "path": "a.txt",
          "digest": "blake3:e0e63aa4c8e1ed796cb104d8a074e553c99fff18d140e886667013ef2780ae23",
          "size": 4
        },
        {
          "path": "b.txt",
          "digest": "blake3:ef40086ad8a395c7a05b5f70cf2575ad187f637ad813136292cb39610694db73",
          "size": 4
        }
      ],
      "expect": {
        "ok": false,
        "checked": 2,
        "findings": [
          {
            "path": "a.txt",
            "status": "mismatch",
            "expected": "blake3:e0e63aa4c8e1ed796cb104d8a074e553c99fff18d140e886667013ef2780ae23",
            "actual": "blake3:cbeb7950aa328c4cf8da7a717ddd45858f5b9e40d3ec6b8d3ad329b887d789bd"
          },
          {
            "path": "b.txt",
            "status": "removed",
            "expected": "blake3:ef40086ad8a395c7a05b5f70cf2575ad187f637ad813136292cb39610694db73",
            "actual": null
          },
          {
            "path": "c.txt",
            "status": "added",
            "expected": null,
            "actual": "blake3:79d1d8da0b625035cdbfc9d51841030861b9f4cf7c5abbe442a8d13efc352170"
          }
        ]
      }
    },
    {
      "id": "readme_md_crlf_raw",
      "description": "Markdown CRLF raw_file_digest",
      "kind": "raw_file_digest",
      "path": "readme.md",
      "content": "# Title\r\n\r\nBody\r\n",
      "expect": {
        "digest": "blake3:1d214c1dbb2fa2352037849f6940df8d404c107b13e0215d3ccc87ffc13d6d43",
        "size": 17
      }
    }
  ]
}
